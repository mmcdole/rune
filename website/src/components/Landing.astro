---
// The landing page body. A deck of cards shows each feature in an HTML drawing
// of Rune's own UI (taken from tmux captures of the running client), with the
// Lua or keys for that feature beside it. A card's markup is its finished
// frame; the script at the bottom plays it when the card comes to the front.
// Terminal text sits in <pre> elements so HTML compression keeps its spacing.
// Code samples live here because Lua's braces would be Astro expressions in
// the markup.
const raw = import.meta.env.BASE_URL;
const base = raw.endsWith('/') ? raw : raw + '/';

const status = '<span><span class="g">●</span> <span class="d">mud.arctic.org:2700</span></span><span class="d">LIVE</span>';

const layoutLineSimple = String.raw`<pre><span class="ln" data-m="bind"><span class="f">rune</span>.<span class="f">bind</span>(<span class="s">"~"</span>, <span class="k">function</span>() <span class="f">rune</span>.pane.<span class="f">toggle</span>(<span class="s">"chat"</span>) <span class="k">end</span>)</span></pre>`;

const layoutLineAdv = String.raw`<pre><span class="ln" data-m="bind"><span class="f">rune</span>.<span class="f">bind</span>(<span class="s">"f3"</span>, <span class="k">function</span>() <span class="f">rune</span>.ui.regions.<span class="f">toggle</span>(<span class="s">"left"</span>) <span class="k">end</span>)</span></pre>`;

const layoutCodeSimple = String.raw`<pre><span class="f">rune</span>.ui.<span class="f">layout</span>({ type = <span class="s">"column"</span>, children = {
  { type = <span class="s">"pane"</span>, name = <span class="s">"chat"</span>, size = <span class="n">6</span>,
    border = <span class="s">"horizontal"</span>, hidden = <span class="k">true</span> },
  { type = <span class="s">"pane"</span>, name = <span class="s">"output"</span>, border = <span class="s">"none"</span> },
  { type = <span class="s">"input"</span> },
  { type = <span class="s">"bar"</span>, name = <span class="s">"status"</span> },
}})

<span class="ln" data-m="bind"><span class="f">rune</span>.<span class="f">bind</span>(<span class="s">"~"</span>, <span class="k">function</span>()</span>
<span class="ln" data-m="bind">  <span class="f">rune</span>.pane.<span class="f">toggle</span>(<span class="s">"chat"</span>)</span>
<span class="ln" data-m="bind"><span class="k">end</span>)</span></pre>`;

const layoutCodeAdv = String.raw`<pre><span class="f">rune</span>.ui.<span class="f">layout</span>({ type = <span class="s">"column"</span>, children = {
  { type = <span class="s">"row"</span>, dividers = <span class="k">true</span>, children = {
    { type = <span class="s">"column"</span>, id = <span class="s">"left"</span>, size = <span class="n">14</span>, children = {
      { type = <span class="s">"pane"</span>, name = <span class="s">"map"</span> },
      { type = <span class="s">"pane"</span>, name = <span class="s">"group"</span> },
    }},
    { type = <span class="s">"column"</span>, children = {
      { type = <span class="s">"pane"</span>, name = <span class="s">"output"</span>, border = <span class="s">"none"</span> },
      { type = <span class="s">"input"</span> },
    }},
    { type = <span class="s">"pane"</span>, name = <span class="s">"chat"</span>, size = <span class="n">26</span> },
  }},
  { type = <span class="s">"bar"</span>, name = <span class="s">"vitals"</span> },
}})

<span class="ln" data-m="bind"><span class="f">rune</span>.<span class="f">bind</span>(<span class="s">"f3"</span>, <span class="k">function</span>()</span>
<span class="ln" data-m="bind">  <span class="f">rune</span>.ui.regions.<span class="f">toggle</span>(<span class="s">"left"</span>) <span class="k">end</span>)</span></pre>`;

const pickerLine = String.raw`<pre><span class="ln" data-m="show"><span class="f">rune</span>.ui.picker.<span class="f">show</span>({ title = <span class="s">"Where to?"</span>, items = places,</span>
<span class="ln" data-m="show">  on_select = <span class="k">function</span>(place) <span class="f">rune</span>.<span class="f">send</span>(<span class="s">"walkto "</span> .. place) <span class="k">end</span> })</span></pre>`;

const pickerCode = String.raw`<pre><span class="cm">-- A picker of your own, on a key</span>
<span class="ln" data-m="bind"><span class="f">rune</span>.<span class="f">bind</span>(<span class="s">"f2"</span>, <span class="k">function</span>()</span>
<span class="ln" data-m="show">  <span class="f">rune</span>.ui.picker.<span class="f">show</span>({</span>
<span class="ln" data-m="show">    title = <span class="s">"Where to?"</span>,</span>
<span class="ln" data-m="show">    items = {</span>
<span class="ln" data-m="show">      { text = <span class="s">"temple"</span>, desc = <span class="s">"the safe room"</span> },</span>
<span class="ln" data-m="show">      { text = <span class="s">"smithy"</span>, desc = <span class="s">"repairs"</span> },</span>
<span class="ln" data-m="show">      { text = <span class="s">"harbor"</span>, desc = <span class="s">"boats east"</span> },</span>
<span class="ln" data-m="show">    },</span>
    on_select = <span class="k">function</span>(place)
      <span class="f">rune</span>.<span class="f">send</span>(<span class="s">"walkto "</span> .. place)
    <span class="k">end</span>,
  })
<span class="k">end</span>)</pre>`;

const highlightLine = String.raw`<pre><span class="ln" data-m="color"><span class="f">rune</span>.trigger.<span class="f">contains</span>(<span class="s">"smashes you"</span>, <span class="k">function</span>(_, ctx) <span class="k">return</span> <span class="f">rune</span>.style.<span class="f">red</span>(ctx.line:<span class="f">clean</span>()) <span class="k">end</span>)</span>
<span class="ln" data-m="gag"><span class="f">rune</span>.trigger.<span class="f">contains</span>(<span class="s">"drops a piece of lint"</span>, <span class="k">nil</span>, { gag = <span class="k">true</span> })</span></pre>`;

const highlightCode = String.raw`<pre><span class="ln" data-m="color"><span class="f">rune</span>.trigger.<span class="f">contains</span>(<span class="s">"smashes you"</span>, <span class="k">function</span>(_, ctx)</span>
<span class="ln" data-m="color">  <span class="k">return</span> <span class="f">rune</span>.style.<span class="f">red</span>(ctx.line:<span class="f">clean</span>())</span>
<span class="k">end</span>, { group = <span class="s">"combat"</span> })

<span class="k">local</span> gags = {
  <span class="s">"drops a piece of lint"</span>,
  <span class="s">"A gentle breeze blows"</span>,
  <span class="s">"The barkeep polishes a glass"</span>,
}

<span class="ln" data-m="gag"><span class="k">for</span> _, text <span class="k">in</span> <span class="f">ipairs</span>(gags) <span class="k">do</span></span>
<span class="ln" data-m="gag">  <span class="f">rune</span>.trigger.<span class="f">contains</span>(text, <span class="k">nil</span>, {</span>
<span class="ln" data-m="gag">    gag = <span class="k">true</span>, group = <span class="s">"combat"</span>,</span>
<span class="ln" data-m="gag">  })</span>
<span class="ln" data-m="gag"><span class="k">end</span></span></pre>`;

const triggerCode = String.raw`<pre><span class="cm">-- Type qh yourself, or let the trigger do it</span>
<span class="ln" data-m="alias"><span class="f">rune</span>.alias.<span class="f">exact</span>(<span class="s">"qh"</span>,</span>
<span class="ln" data-m="alias">  <span class="s">"get potion from bag;quaff potion;drop bottle"</span>)</span>

<span class="ln" data-m="match"><span class="f">rune</span>.trigger.<span class="f">regex</span>(<span class="s">"^Your health is (\\d+)%\\.$"</span>,</span>
  <span class="k">function</span>(m)
<span class="ln" data-m="if">    <span class="k">if</span> <span class="f">tonumber</span>(m[<span class="n">1</span>]) &lt; <span class="n">30</span> <span class="k">then</span></span>
<span class="ln" data-m="send">      <span class="f">rune</span>.<span class="f">send</span>(<span class="s">"qh"</span>)</span>
    <span class="k">end</span>
  <span class="k">end</span>)

<span class="cm">-- Save, type /reload, keep playing.</span></pre>`;
---

<div class="landing not-content">
  <section class="hero">
    <div class="hero-copy">
      <h1><em>Rune</em> MUD Client<span class="blk" aria-hidden="true"></span></h1>
      <div class="lede">
        <p>A terminal client with panes, pickers, and Lua scripting.</p>
        <p class="platforms">Linux, macOS, and Windows</p>
      </div>
      <div class="get">
        <a class="btn" href="https://github.com/mmcdole/rune/releases">Download</a>
        <div class="cmd">
          <span class="sh">$</span><span class="txt" id="install-cmd">go install github.com/mmcdole/rune/cmd/rune@latest</span>
          <button type="button" id="install-copy">Copy</button>
        </div>
      </div>
    </div>

    <div class="feat">
      <div class="striprow">
        <div class="strip" id="strip" role="group" aria-label="Features"></div>
      </div>
      <div class="deckrow">
        <div class="deckwrap" id="wrap">
          <div class="key" id="key" aria-hidden="true"><span id="keylabel"></span><kbd id="keycap"></kbd></div>
          <div class="deck">

            <article class="card" data-anim="layout" data-name="Layouts" data-text="Start with one chat pane above the output, or split the screen into rows and columns of panes and bars. Show or hide any of them with a key." data-link={`${base}interface/layout/`} data-label="Layout guide">
              <div class="rt" role="img" aria-label="A chat pane opening above the output, then a three-column layout with map, group, output, chat, and gauges">
                <div class="stage" data-simple hidden>
                  <div data-chat hidden>
                    <div class="phead"><span class="ttl">chat</span><i></i></div>
<pre class="out"><span class="y">[Chat]</span> Knubo: builder port tonight
<span class="c">[Tell]</span> Kralk: knife is ready
<span class="c">[Tell]</span> Ozric: heal me!!
<span class="y">[Chat]</span> Mirel: anyone selling torches?</pre>
                    <div class="hr"></div>
                  </div>
                  <pre class="out grow" data-out></pre>
                  <div data-rows></div>
                  <div class="hr"></div>
                  <pre class="out" data-q></pre>
                  <div class="hr"></div>
                  <pre class="bar" set:html={status} />
                </div>
                <div class="stage" data-adv>
                <div class="tri">
                  <div class="col left">
<pre class="hbox"><span class="ttl">map</span><span class="d">   [ ]-[ ]
    |
[ ]-</span>[<span class="y">*</span>]<span class="d">-[ ]
    |
   [ ]</span></pre>
<pre class="hbox"><span class="ttl">group</span>Tundra    <span class="g">342</span>
Moreldir  <span class="y">198</span>
Ozric      <span class="r">41</span></pre>
                  </div>
                  <div class="main">
<pre class="out"><b>The Crypt Gate</b>
Cold air spills from
the stairs below. Bones
litter the threshold.
<span class="d">    Exits: </span><span class="g">down, south</span>
<span class="y">A skeletal guard</span> blocks
the stairs.
<span class="g">&gt; kill guard</span>
You smash the guard.
<span class="r">The guard cuts Ozric.</span>
Ozric is bleeding badly.</pre>
                    <div class="hr"></div>
                    <pre class="out" data-in>&gt; heal ozric<span class="cursor">_</span></pre>
                  </div>
                  <div class="col right">
<pre class="hbox"><span class="ttl">chat</span><span class="c">[Tell]</span> Kralk: knife ready
<span class="c">[Tell]</span> Ozric: heal me!!
<span class="y">[Chat]</span> Knubo: soon
<span class="y">[Chat]</span> Mirel: torch?
<span class="y">[Chat]</span> Mordak: knives
<span class="y">[Chat]</span> Dios: reboot at 9</pre>
                  </div>
                </div>
                <div class="hr"></div>
                <pre class="bar"><span><span class="d">HP</span> <span class="gauge"><i class="hp"></i></span> 342/400  <span class="d">EP</span> <span class="gauge short"><i class="ep"></i></span> 97/120</span><span class="d">The Crypt Gate</span></pre>
                </div>
              </div>
              <template class="oneline" data-stage="simple" set:html={layoutLineSimple} />
              <template class="oneline" data-stage="adv" set:html={layoutLineAdv} />
              <template class="code" data-title="init.lua" data-stage="simple" set:html={layoutCodeSimple} />
              <template class="code" data-title="init.lua" data-stage="adv" set:html={layoutCodeAdv} />
            </article>

            <article class="card" data-anim="picker" data-name="Pickers" data-text="Ctrl+R searches history, Ctrl+T your aliases, / your commands, and /connect your saved worlds. Type to filter. Scripts can open a picker with their own items." data-link={`${base}interface/pickers/`} data-label="Pickers guide">
              <div class="rt" role="img" aria-label="Rune's pickers for history, commands, worlds, and a picker opened by a script">
<pre class="out grow" data-out>Kralk says: the blade needs another hour on the anvil.
<span class="g">&gt; n</span>
<b>The Frozen Forge</b>
Heat rolls off the coals in waves that die fast against the
glacier walls. Kralk the smith hammers a knife blade at the
anvil while Knubo scribbles quest-engine code on a slate.
<span class="d">    There are two obvious exits: </span><span class="g">north and south</span>
<span class="d">[</span><span class="g">HP:342</span> <span class="c">EP:97</span><span class="d">]</span>
Kralk nods at you.</pre>
                <div class="hr" data-pickrule></div>
                <div data-pick>
                  <pre class="row on">&gt; temple - the safe room</pre>
                  <pre class="row">  smithy - repairs</pre>
                  <pre class="row">  harbor - boats east</pre>
                </div>
                <div class="hr"></div>
                <pre class="out" data-q>Where to?: <span class="cursor">_</span></pre>
                <div class="hr"></div>
                <pre class="bar" set:html={status} />
              </div>
              <template class="oneline" set:html={pickerLine} />
              <template class="code" data-title="init.lua" set:html={pickerCode} />
            </article>

            <article class="card" data-anim="search" data-name="Search" data-text="Press Ctrl+F to search everything the server has sent. Matching lines appear above the input with a count, and the output follows the match you select." data-link={`${base}interface/pickers/`} data-label="Pickers and Find">
              <div class="rt" role="img" aria-label="Scrollback search showing lines that match knife">
<pre class="out grow" data-out><span class="y">[Chat]</span> Mirel: anyone selling torches?
<span class="g">&gt; tell kralk is the knife done?</span>
Kralk says: the knife needs another hour on the anvil.
A town guard wanders past.
Moreldir tells you: the knife is ready at the forge
Knubo waves at you.</pre>
                <div class="hr" data-rule></div>
                <div data-rows>
                  <pre class="row">  Kralk hammers a <span class="mt">knife</span> blade at the anvil.</pre>
                  <pre class="row">  <span class="g">&gt;</span> tell kralk is the <span class="mt">knife</span> done?</pre>
                  <pre class="row on">&gt; Kralk says: the <span class="mt">knife</span> needs another hour on the anvil.</pre>
                  <pre class="row">  Moreldir tells you: the <span class="mt">knife</span> is ready at the forge</pre>
                  <pre class="row">  You take the forged <span class="mt">knife</span> from Kralk.</pre>
                </div>
                <pre class="help" data-help>↑ older  ↓ newer  Enter keep  Esc cancel</pre>
                <div class="hr"></div>
                <div class="query" data-q><span>Search: knife<span class="cursor">_</span></span><span>3/5</span></div>
                <div class="hr"></div>
                <pre class="bar"><span><span class="g">●</span> <span class="d">mud.arctic.org:2700</span></span><span data-mode><span class="y">SEARCH</span></span></pre>
              </div>
              <template class="keys" data-title="keys"><div class="keysgrid">
                <code>Ctrl+F</code><span>Search output</span>
                <code>↑ ↓</code><span>Older or newer match</span>
                <code>Enter</code><span>Stay at this point in the scrollback</span>
                <code>Esc</code><span>Go back to live output</span>
                <code>/find</code><span>The same search as a command</span>
              </div></template>
            </article>

            <article class="card" data-anim="highlight" data-name="Highlights" data-text="A trigger can recolor a line or hide it before you see it. Keep your rules in a group and switch them with /group." data-link={`${base}scripting/triggers/`} data-label="Triggers">
              <div class="rt" role="img" aria-label="Combat output before and after highlight and gag rules are turned on">
<pre class="out grow" data-out>&gt; /group combat on
[Group] combat enabled
You hack at the frost troll.
<span class="r">The frost troll smashes you with its club!</span>
You parry the frost troll's attack.
<span class="g">You hack the frost troll to pieces!</span>
<span class="y">The frost troll drops a jagged tooth.</span></pre>
                <div class="hr"></div>
                <pre class="out" data-in>&gt; <span class="cursor">_</span></pre>
                <div class="hr"></div>
                <pre class="bar" set:html={status} />
              </div>
              <template class="oneline" set:html={highlightLine} />
              <template class="code" data-title="init.lua" set:html={highlightCode} />
            </article>

            <article class="card" data-anim="input" data-name="Input" data-text="Tab cycles through names from recent output. Paste several lines, or press Ctrl+Enter, and the input becomes a numbered editor. Ctrl+E opens the draft in your $EDITOR." data-link={`${base}interface/input/`} data-label="Input and history">
              <div class="rt" role="img" aria-label="Tab completion cycling through names, then the multiline editor">
<pre class="out grow"><b>The Post Office</b>
A clerk sorts letters behind a frost-rimed counter.
Moreldir tells you: the knife is ready at the forge
Mordak says: forged knives, cheap until the reboot
Morwen waves at you.
<span class="g">&gt; mail kralk</span>
Subject: the knife
Enter your message. End with a '.' on a line by itself.</pre>
                <div data-plain hidden><div class="hr"></div><pre class="out" data-in>&gt; <span class="cursor">_</span></pre><div class="hr"></div></div>
                <div data-comp>
                  <div class="lbl"><span class="y">VERBATIM · <span data-count>4</span> lines</span><i></i><span class="end">Alt+V command</span></div>
<pre class="num" data-num><span>1 │ </span>Dear Kralk,
<span>2 │ </span>
<span>3 │ </span>The knife you forged is perfect.
<span>4 │ </span>  - Tundra<span class="cursor">_</span></pre>
                  <div class="lbl"><span>Enter send · Ctrl+J newline · Esc×2 discard · Ctrl+E editor</span><i></i></div>
                </div>
                <pre class="bar" data-bar><span><span class="g">●</span> <span class="d">mud.arctic.org:2700</span></span><span class="d">LIVE</span></pre>
              </div>
              <template class="keys" data-title="keys"><div class="keysgrid">
                <code>Tab</code><span>Cycle names from recent output</span>
                <code>Up</code><span>History, matching what you've typed</span>
                <code>Ctrl+Enter</code><span>Numbered multiline editor</span>
                <code>Ctrl+E</code><span>Edit the draft in <code>$EDITOR</code></span>
                <code>kill rat;loot</code><span>Send two commands</span>
                <code>#3 north</code><span>Repeat a command</span>
                <code>!k</code><span>Repeat the last command starting with k</span>
              </div></template>
            </article>

            <article class="card" data-anim="trigger" data-name="Scripting" data-text="Triggers, aliases, timers, hooks, key bindings, and slash commands are Lua. Rune loads init.lua at startup and /reload picks up changes." data-link={`${base}getting-started/scripting-basics/`} data-label="Scripting basics">
              <div class="rt" role="img" aria-label="A Lua trigger running a potion alias when health drops">
                <div class="inl">
                  <div class="phead"><span class="ttl">init.lua</span><i></i></div>
<pre class="out"><span class="ln" data-m="alias"><span class="f">rune</span>.alias.<span class="f">exact</span>(<span class="s">"qh"</span>,</span>
<span class="ln" data-m="alias">  <span class="s">"get potion from bag;quaff potion;drop bottle"</span>)</span>

<span class="ln" data-m="match"><span class="f">rune</span>.trigger.<span class="f">regex</span>(<span class="s">"^Your health is (\\d+)%\\.$"</span>, <span class="k">function</span>(m)</span>
<span class="ln" data-m="if">  <span class="k">if</span> <span class="f">tonumber</span>(m[<span class="n">1</span>]) &lt; <span class="n">30</span> <span class="k">then</span> <span class="f">rune</span>.<span class="f">send</span>(<span class="s">"qh"</span>) <span class="k">end</span></span>
<span class="k">end</span>)</pre>
                  <div class="hr"></div>
                </div>
<pre class="out grow" data-out>Your health is 24%.
You get a healing potion from your bag.
You quaff a healing potion. You feel much better.
You drop an empty bottle.
<span class="d">[</span><span class="g">HP:301</span> <span class="c">EP:97</span><span class="d">]</span></pre>
                <div class="hr"></div>
                <pre class="out" data-in>&gt; <span class="cursor">_</span></pre>
                <div class="hr"></div>
                <pre class="bar" set:html={status} />
              </div>
              <template class="code" data-title="init.lua" set:html={triggerCode} />
            </article>

          </div>
        </div>
        <aside class="side" aria-label="Code or keys for this feature">
          <div class="sidehead" id="sidehead"></div>
          <div class="sidebody" id="sidebody"></div>
        </aside>
      </div>
      <div class="desc" id="desc"></div>
    </div>
  </section>

  <section class="closing">
    <h2>Get started</h2>
    <p>Connect from your shell, then save the world so you can reconnect by name.</p>
    <div class="cmd"><span class="sh">$</span><span class="txt">rune mud.arctic.org 2700</span></div>
    <div class="cmd"><span class="sh">&gt;</span><span class="txt">/world add arctic mud.arctic.org 2700</span></div>
    <p class="more">
      <a href={`${base}getting-started/first-session/`}>Your first session</a> · <a href={`${base}getting-started/migrating/`}>Coming from Mudlet, TinTin++, or MUSHclient</a>
    </p>
  </section>
</div>

<style is:global>
  /* Global because the demo script writes markup that scoped styles would not
     reach. Everything is nested under .landing. */
  .landing {
    --ground: #101211;
    --surface: #181c1a;
    --plate: #1e2320;
    --rule: #2c322f;
    --edge: #363d39;
    --fg: #e1e4de;
    --text: #c9cdc6;
    --muted: #98a099;
    --faint: #7f8781;
    --brass: #d9b36b;
    --brass-fill: #c8a25a;
    --on-brass: #14120c;
    /* ANSI colors, used only inside terminals */
    --t-cyan: #6ed3e3;
    --t-green: #a6d86a;
    --t-yellow: #edc65a;
    --t-red: #f0827c;
    --t-mag: #c79bf2;
    --t-blue: #7fa8ff;
    --t-pink: #ff7fd0;
    --t-badge: #6259e8;
    --t-mark: #38347a;
    --t-line: #3a403d;
    --mono: var(--sl-font-mono);

    color: var(--text);
    font-size: 16px;
    line-height: 1.6;

    & [hidden] { display: none !important; }
    & > section {
      max-width: 820px;
      margin: 0 auto;
    }
    & h1, & h2, & p { margin: 0; }
    & a {
      color: var(--fg);
      text-underline-offset: 3px;
      text-decoration-color: var(--faint);
    }
    & code {
      font: 0.875em var(--mono);
      color: var(--fg);
    }
    & pre {
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      color: inherit;
      overflow: visible;
    }
    & button:focus-visible, & a:focus-visible {
      outline: 2px solid var(--brass);
      outline-offset: 2px;
    }

    /* Hero */
    & .hero {
      padding-block: 52px 36px;
      display: grid;
      gap: 34px;
    }
    & .hero-copy {
      display: grid;
      gap: 20px;
      justify-items: center;
      text-align: center;
      min-width: 0;
    }
    & h1 {
      font-size: clamp(38px, 6vw, 64px);
      line-height: 1.04;
      font-weight: 600;
      letter-spacing: -0.03em;
      color: var(--fg);
      & em { font-style: normal; color: var(--brass); }
      & .blk {
        display: inline-block;
        width: 0.46em;
        height: 0.8em;
        margin-left: 0.14em;
        background: var(--brass);
        vertical-align: -0.05em;
      }
    }
    & .lede {
      display: grid;
      gap: 4px;
      & p { font-size: 20px; color: var(--muted); }
      & .platforms { font-size: 14px; }
    }
    & .get {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 12px 14px;
      max-width: 100%;
    }
    & .btn {
      display: inline-flex;
      font: 600 15px var(--sl-font);
      background: var(--brass-fill);
      color: var(--on-brass);
      text-decoration: none;
      padding: 10px 20px;
      border-radius: 4px;
    }
    & .cmd {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
      max-width: 100%;
      font: 13.5px var(--mono);
      background: var(--surface);
      border: 1px solid var(--rule);
      border-radius: 4px;
      padding: 9px 10px 9px 14px;
      & .sh { color: var(--faint); user-select: none; }
      & .txt { overflow-x: auto; white-space: nowrap; }
      & button {
        font: 12px var(--sl-font);
        color: var(--muted);
        background: none;
        border: 1px solid var(--rule);
        border-radius: 3px;
        padding: 2px 8px;
        cursor: pointer;
      }
      & button:hover { color: var(--fg); }
    }

    /* Feature tabs, the deck, and the code beside it */
    & .feat { display: grid; gap: 14px; min-width: 0; }
    & .striprow { display: flex; align-items: center; min-height: 40px; min-width: 0; }
    & .strip {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      & button {
        font: 14px var(--mono);
        padding: 3px 10px;
        border: 0;
        cursor: pointer;
        background: #232826;
        color: var(--muted);
      }
      & button:hover { color: var(--fg); }
      & button[aria-pressed='true'] { background: var(--t-badge); color: #f4f2dc; }
    }
    & .deckrow {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      min-width: 0;
    }
    & .deckwrap { position: relative; min-width: 0; }
    & .deck { container-type: inline-size; display: grid; padding-bottom: 40px; }
    & .card {
      grid-area: 1 / 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      background: var(--surface);
      border: 1px solid var(--edge);
      border-radius: 5px;
      box-shadow: 0 26px 56px -24px #000;
      overflow: hidden;
      transform-origin: 50% 100%;
      transform: translateY(calc(var(--p) * 9px)) scale(calc(1 - var(--p) * 0.026));
      filter: brightness(calc(1 - var(--p) * 0.16));
      transition: transform 0.36s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.36s, opacity 0.3s;
    }
    & .card:not(.front) { cursor: pointer; }
    & .card.out {
      z-index: 20 !important;
      opacity: 0;
      filter: none !important;
      transform: translate(-46px, 42px) rotate(-3deg) !important;
      pointer-events: none;
    }
    & .stage { flex: 1; display: flex; flex-direction: column; min-width: 62ch; }

    /* The key a demo is pressing, in the middle of the card */
    & .key {
      position: absolute;
      z-index: 30;
      inset: 0 0 40px;
      margin: auto;
      width: fit-content;
      height: fit-content;
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--ground);
      border: 1px solid var(--edge);
      border-radius: 10px;
      padding: 5px 7px 5px 13px;
      box-shadow: 0 12px 26px -8px #000;
      opacity: 0;
      transform: translateY(5px);
      transition: opacity 0.16s, transform 0.16s;
      pointer-events: none;
      & span { font: 13px var(--mono); color: var(--brass); white-space: nowrap; }
      & kbd {
        font: 600 18px var(--mono);
        color: var(--on-brass);
        background: var(--brass);
        border: 1px solid #f0d596;
        border-bottom: 4px solid #8f7038;
        border-radius: 7px;
        padding: 3px 14px;
        transition: transform 0.09s, border-bottom-width 0.09s;
      }
      & kbd.press { transform: translateY(3px); border-bottom-width: 1px; }
    }
    & .key.show { opacity: 1; transform: none; }

    /* The panel beside the deck: init.lua or a list of keys */
    & .side {
      display: none;
      min-width: 0;
      margin-bottom: 40px;
      background: #141716;
      border: 1px solid var(--rule);
      border-radius: 5px;
      overflow: hidden;
      flex-direction: column;
    }
    & .sidehead {
      font: 12.5px var(--mono);
      color: var(--muted);
      border-bottom: 1px solid var(--rule);
      padding: 6px 16px;
    }
    & .sidebody {
      padding: 8px 14px;
      overflow: auto;
      flex: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      & pre { font: 10.5px/1.4 var(--mono); color: var(--text); white-space: pre; }
    }
    & .ln { padding-block: 2px; transition: background-color 0.18s; }
    & .ln.hit { background: var(--t-mark); color: #f4f2dc; }
    & .ln.hit span { color: inherit; }
    & .k { color: var(--t-mag); }
    & .s { color: var(--t-green); }
    & .n { color: var(--t-yellow); }
    & .cm { color: var(--faint); }
    & .f { color: var(--t-cyan); }
    & .keysgrid {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 9px 16px;
      font-size: 14px;
      align-content: start;
      & code { color: var(--brass); white-space: nowrap; }
    }

    /* Description under the deck */
    & .desc {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
      min-height: 7.2em;
      align-content: start;
      justify-items: center;
      text-align: center;
      & p { max-width: 64ch; }
      & h2 { font-size: 24px; line-height: 1.25; font-weight: 600; letter-spacing: -0.015em; color: var(--fg); }
    }
    & .more { font-size: 14px; }
    & .snip {
      display: none;
      font: 13px/1.6 var(--mono);
      color: var(--text);
      background: var(--surface);
      border: 1px solid var(--rule);
      border-radius: 4px;
      padding: 9px 14px;
      margin-block: 8px 4px;
      overflow-x: auto;
      max-width: 100%;
      & pre { white-space: pre; }
    }
    & .swap { animation: swap 0.28s ease-out; }

    /* Closing */
    & .closing {
      border-top: 1px solid var(--rule);
      padding-block: 36px 56px;
      display: grid;
      gap: 12px;
      justify-items: start;
      & h2 { font-size: 24px; line-height: 1.25; font-weight: 600; color: var(--fg); }
      & p { color: var(--muted); }
      & .cmd { width: 100%; max-width: 34rem; }
    }

    /* Terminals: Rune's own UI. Text shrinks with the card so 66 columns
       (40em of Plex Mono) always fit. */
    & .rt {
      flex: 1;
      display: flex;
      flex-direction: column;
      position: relative;
      padding: 14px 16px 8px;
      font: 14px/1.4 var(--mono);
      font-size: clamp(6.5px, (100cqw - 34px) / 40, 12.5px);
      color: var(--text);
      overflow: hidden;
      min-width: 0;
      & > * { min-width: 62ch; }
      & .out, & .num, & .bar, & .hbox { white-space: pre; }
      & .out { overflow: hidden; }
      & b { font-weight: 600; color: #eef0ea; }
      & .grow { margin-top: auto; }
    }
    & .hr { border-top: 1px solid var(--t-line); margin-block: 0.45em; }
    & .bar { display: flex; justify-content: space-between; }
    & .tsel { background: #d4d7d0; color: var(--surface); }
    & .ttl { background: var(--t-badge); color: #f4f2dc; padding: 0 1ch; }
    & .phead {
      display: flex;
      align-items: center;
      & i { flex: 1; border-top: 1px solid var(--t-line); }
    }
    & .inl { display: none; }
    & .row { color: #cfd2cb; white-space: pre; overflow: hidden; }
    & .row.on { background: var(--t-badge); color: #f4f2dc; }
    & .mt { color: var(--t-pink); font-weight: 600; }
    & .help { color: var(--faint); white-space: pre; }
    & .query { display: flex; justify-content: space-between; white-space: pre; }
    & .lbl {
      display: flex;
      align-items: center;
      gap: 1ch;
      white-space: pre;
      color: var(--faint);
      margin-block: 0.45em;
      &::before, &::after { content: ''; width: 1ch; border-top: 1px solid var(--t-line); }
      &::after { order: 9; }
      & i { flex: 1; border-top: 1px solid var(--t-line); }
      & .end { order: 8; }
    }
    & .num span { color: var(--faint); }
    & .hbox {
      position: relative;
      border-top: 1px solid var(--t-line);
      padding: 0.55em 0 0 1ch;
      & > .ttl { position: absolute; top: -0.72em; left: 0; line-height: 1.4; }
    }
    & .tri {
      display: grid;
      flex: 1;
      grid-template-columns: 14ch minmax(0, 1fr) 26ch;
      &.hid { grid-template-columns: minmax(0, 1fr) 26ch; }
      &.hid .col.left { display: none; }
    }
    & .main {
      display: grid;
      align-content: end;
      min-width: 0;
      padding-inline: 1ch;
      & .hr { margin-inline: -1ch; }
    }
    & .col { display: grid; padding-top: 0.7em; overflow: hidden; }
    & .col.left {
      border-right: 1px solid var(--t-line);
      grid-template-rows: 1fr 1fr;
      gap: 1.4em;
      & .hbox { padding: 0.55em 1ch 0 0; }
    }
    & .col.right { border-left: 1px solid var(--t-line); }
    & .gauge {
      display: inline-block;
      width: 14ch;
      height: 0.7em;
      background: var(--t-line);
      &.short { width: 8ch; }
      & i { display: block; height: 100%; }
      & .hp { width: 85%; background: var(--t-green); }
      & .ep { width: 81%; background: var(--t-blue); }
    }
    & .c { color: var(--t-cyan); }
    & .g { color: var(--t-green); }
    & .y { color: var(--t-yellow); }
    & .r { color: var(--t-red); }
    & .d { color: var(--faint); }
    & .cursor {
      display: inline-block;
      width: 0.6em;
      background: #d4d7d0;
      color: transparent;
    }

    /* Wide enough for the code beside the terminal */
    @media (min-width: 960px) {
      & > section { max-width: 1120px; }
      & .deckrow { grid-template-columns: minmax(0, 1fr) clamp(404px, 40%, 440px); }
      & .side { display: flex; height: 0; min-height: calc(100% - 40px); }
    }
    @media (min-width: 960px) and (max-width: 999px) {
      & .sidebody pre { line-height: 1.32; }
    }
    @media (max-width: 980px) {
      & .key { padding: 3px 3px 3px 9px; border-radius: 8px; }
      & .key span { font-size: 12px; }
      & .key kbd { font-size: 13px; padding: 1px 9px; border-radius: 5px; }
    }
    /* Terminal alone, with a line or two of the code under the description */
    @media (max-width: 959px) {
      & .inl { display: block; }
      & .snip:not(:empty) { display: block; }
      & .desc { min-height: 218px; }
    }
    @media (max-width: 640px) {
      & .hero { padding-block: 36px 28px; }
      & .get { display: grid; }
      & .btn { justify-content: center; }
      & .get .cmd { display: none; }
      & .desc { min-height: 11em; }
      & .snip:not(:empty) { display: none; }
    }
    @media (prefers-reduced-motion: no-preference) {
      & .cursor, & h1 .blk { animation: blink 1.1s steps(1) infinite; }
    }
    @media (prefers-reduced-motion: reduce) {
      & .card, & .swap, & .key, & .key kbd, & .ln { transition: none; animation: none; }
    }
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  @keyframes swap {
    from { opacity: 0; transform: translateY(5px); }
  }

  /* The landing provides its own hero: hide the auto-rendered page title. */
  .content-panel:has(> .sl-container > h1#_top) { display: none; }
  h1#_top { display: none; }

  /* The landing sizes its own sections, wider than Starlight's splash column. */
  .content-panel:has(.landing) { padding: 0 16px; }
  .content-panel .sl-container:has(.landing) { max-width: none; }
</style>

<script>
  const installCopy = document.getElementById('install-copy');
  const installCmd = document.getElementById('install-cmd');
  installCopy?.addEventListener('click', () => {
    navigator.clipboard.writeText(installCmd?.textContent ?? '').then(
      () => {
        installCopy.textContent = 'Copied';
        setTimeout(() => (installCopy.textContent = 'Copy'), 1500);
      },
      () => {},
    );
  });

  // The feature deck. Each card's markup is its finished frame. The front card
  // resets to its opening frame, plays, holds, and hands off to the next card.
  // Choosing a tab or a card jumps there and holds longer. Reduced-motion
  // visitors see only the finished frames.
  type Step = (ms: number) => Promise<void>;
  type Press = (key: string, label: string) => Promise<void>;
  type Anim = (rt: HTMLElement, step: Step, press: Press) => Promise<void>;

  const HOLD = 3200;
  const PICKED_HOLD = 9000;
  const STATUS = '<span><span class="g">●</span> <span class="d">mud.arctic.org:2700</span></span><span class="d">LIVE</span>';
  const PROMPTLINE = '<span class="d">[</span><span class="g">HP:342</span> <span class="c">EP:97</span><span class="d">]</span>';
  const prompt = (text: string) => `&gt; ${text}<span class="cursor">_</span>`;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = (root: ParentNode, sel: string) => root.querySelector(sel) as HTMLElement;
  const byId = (id: string) => document.getElementById(id) as HTMLElement;
  const hit = (text: string, q: string) => {
    const at = q ? text.indexOf(q) : -1;
    return at < 0 ? text : `${text.slice(0, at)}<span class="mt">${q}</span>${text.slice(at + q.length)}`;
  };

  const wrap = byId('wrap');
  const cards = [...document.querySelectorAll<HTMLElement>('.landing .card')];
  const desc = byId('desc');
  const strip = byId('strip');
  const key = byId('key');
  const keylabel = byId('keylabel');
  const keycap = byId('keycap');
  const sidehead = byId('sidehead');
  const sidebody = byId('sidebody');
  const finished = new Map(cards.map((c) => [c, $(c, '.rt').innerHTML]));
  let active = cards[0];
  let hovering = false;
  let run = 0;

  // Lights up the lines of code that are running.
  const mark = (name: string) => {
    document.querySelectorAll<HTMLElement>('#sidebody .ln, #desc .ln, .card.front .inl .ln').forEach((l) => l.classList.toggle('hit', l.dataset.m === name));
  };

  async function type(step: Step, el: HTMLElement, text: string, ms: number) {
    for (let i = 1; i <= text.length; i++) {
      el.innerHTML = prompt(text.slice(0, i));
      await step(ms);
    }
  }

  const anims: Record<string, Anim> = {
    async layout(rt, step, press) {
      const simple = $(rt, '[data-simple]');
      const adv = $(rt, '[data-adv]');
      const chat = $(rt, '[data-chat]');
      const out = $(simple, '[data-out]');
      const rows = $(simple, '[data-rows]');
      const query = $(simple, '[data-q]');
      const tri = $(rt, '.tri');
      const input = $(adv, '[data-in]');
      const main = $(adv, '.main .out');
      const log = [
        '<b>The Crypt Gate</b>',
        'Cold air spills from the stairs below. Bones litter the threshold.',
        '<span class="d">    There are two obvious exits: </span><span class="g">down and south</span>',
        '<span class="y">A skeletal guard</span> blocks the stairs.',
        '<span class="y">[Chat]</span> Knubo: builder port tonight',
        '<span class="g">&gt; kill guard</span>',
        'You smash the guard.',
        '<span class="c">[Tell]</span> Kralk: knife is ready',
        '<span class="r">The guard cuts Ozric.</span>',
        '<span class="c">[Tell]</span> Ozric: heal me!!',
        '<span class="y">[Chat]</span> Mirel: anyone selling torches?',
        PROMPTLINE,
      ];
      const height = log.length;
      const draw = (open: boolean, items: string[], q: string) => {
        chat.hidden = !open;
        rows.innerHTML = items.length
          ? `<div class="hr"></div>${items.map((t, i) => `<pre class="row${i === 0 ? ' on' : ''}">${i === 0 ? '&gt; ' : '  '}${hit(t, q)}</pre>`).join('')}`
          : '';
        const room = height - (open ? 4 : 0) - (items.length ? items.length + 1 : 0);
        out.innerHTML = log.slice(-room).join('\n');
      };

      simple.hidden = false;
      adv.hidden = true;
      fillCode(active, 'simple');
      draw(false, [], '');
      query.innerHTML = prompt('');
      await step(900);
      mark('bind');
      await press('~', 'open chat');
      draw(true, [], '');
      await step(1800);
      await press('~', 'close chat');
      draw(false, [], '');
      mark('');
      await step(800);

      const reload = '/reload - Reload all scripts';
      const steps: [string, string[]][] = [
        ['/', ['/aliases - List all aliases', '/bars - List all bar renderers', '/binds - List all key bindings']],
        ['/r', ['/reconnect - Reconnect to last server', reload, '/raw - Send text without alias expansion']],
        ['/re', ['/reconnect - Reconnect to last server', reload]],
        ['/rel', [reload]],
        ['/relo', [reload]],
        ['/reloa', [reload]],
        ['/reload', [reload]],
      ];
      for (const [q, items] of steps) {
        draw(false, items, q);
        query.innerHTML = prompt(q);
        await step(q === '/' ? 420 : 130);
      }
      await step(400);
      await press('Enter', 'load a bigger layout');

      const before = main.innerHTML.split('\n');
      main.innerHTML = [...before.slice(0, -1), '<span class="d">[System] Scripts reloaded</span>'].join('\n');
      input.innerHTML = prompt('');
      simple.hidden = true;
      adv.hidden = false;
      tri.classList.remove('hid');
      fillCode(active, 'adv');
      await step(1500);
      mark('bind');
      await press('F3', 'hide map and group');
      tri.classList.add('hid');
      await step(1500);
      await press('F3', 'show them again');
      tri.classList.remove('hid');
      await step(500);
      mark('');
    },

    async picker(rt, step, press) {
      const out = $(rt, '[data-out]');
      const rows = $(rt, '[data-pick]');
      const rule = $(rt, '[data-pickrule]');
      const query = $(rt, '[data-q]');
      const output = out.innerHTML.split('\n');
      const draw = (items: string[], q: string, label: string) => {
        rows.innerHTML = items.map((t, i) => `<pre class="row${i === 0 ? ' on' : ''}">${i === 0 ? '&gt; ' : '  '}${hit(t, q)}</pre>`).join('');
        rule.hidden = items.length === 0;
        out.innerHTML = output.slice(-(9 + Math.max(0, 3 - items.length))).join('\n');
        query.innerHTML = label;
      };
      draw([], '', prompt(''));
      await step(600);

      const history = ['tell moreldir on my way', 'kill polar bear', 'tell soblak ready when you are', 'get all from corpse', 'tell dios when is the restart?'];
      await press('Ctrl+R', 'search history');
      draw(history, '', `History: <span class="cursor">_</span>`);
      await step(600);
      for (let i = 1; i <= 4; i++) {
        const q = 'tell'.slice(0, i);
        draw(history.filter((h) => h.includes(q)), q, `History: ${q}<span class="cursor">_</span>`);
        await step(260);
      }
      await step(900);

      const cmds = ['/aliases - List all aliases', '/bars - List all bar renderers', '/binds - List all key bindings', '/connect - Connect to a world or address', '/disconnect - Disconnect from server'];
      draw([], '', prompt(''));
      await press('/', 'all commands');
      draw(cmds, '', prompt('/'));
      await step(800);
      draw(['/reconnect - Reconnect to last server', '/reload - Reload all scripts', '/raw - Send text without alias expansion'], '/r', prompt('/r'));
      await step(280);
      draw(['/reconnect - Reconnect to last server', '/reload - Reload all scripts'], '/re', prompt('/re'));
      await step(1200);

      draw([], '', prompt(''));
      await type(step, query, '/connect', 55);
      await press('Enter', 'saved worlds');
      draw(['arctic - mud.arctic.org:2700', 'discworld - discworld.starturtle.net:4242', 'viking - vikingmud.org:2001'], '', `Connect: <span class="cursor">_</span>`);
      await step(1500);

      draw([], '', prompt(''));
      mark('bind');
      await press('F2', 'your own picker');
      mark('show');
      draw(['temple - the safe room', 'smithy - repairs', 'harbor - boats east'], '', `Where to?: <span class="cursor">_</span>`);
      await step(600);
    },

    async search(rt, step, press) {
      const out = $(rt, '[data-out]');
      const rows = $(rt, '[data-rows]');
      const help = $(rt, '[data-help]');
      const rule = $(rt, '[data-rule]');
      const query = $(rt, '[data-q]');
      const mode = $(rt, '[data-mode]');
      const chat = '<span class="y">[Chat]</span> Mirel: anyone selling torches?';
      const log = [
        '<b>The Frozen Forge</b>',
        'Kralk hammers a knife blade at the anvil.',
        chat,
        '<span class="g">&gt;</span> tell kralk is the knife done?',
        'Kralk says: the knife needs another hour on the anvil.',
        'A town guard wanders past.',
        'Moreldir tells you: the knife is ready at the forge',
        'Knubo waves at you.',
        'You take the forged knife from Kralk.',
        PROMPTLINE,
        '<span class="g">&gt;</span> kill polar bear',
        'You hack at the polar bear.',
        PROMPTLINE,
      ];
      const matches = (q: string) => log.map((l, i) => [l, i] as const).filter(([l]) => q && l.replace(/<[^>]+>/g, '').includes(q));
      const closed = () => {
        rows.innerHTML = '';
        help.hidden = true;
        rule.hidden = true;
        out.innerHTML = log.slice(-12).join('\n');
        query.innerHTML = `<span>${prompt('')}</span><span></span>`;
        mode.innerHTML = '<span class="d">LIVE</span>';
      };
      const open = (q: string, sel: number) => {
        const found = matches(q);
        const at = found.length ? Math.max(0, found.length - 1 - sel) : -1;
        rows.innerHTML = found.slice(-5).map(([l], i) => {
          const on = i === at - Math.max(0, found.length - 5);
          return `<pre class="row${on ? ' on' : ''}">${on ? '&gt; ' : '  '}${hit(l.replace(/<span class="g">&gt;<\/span>/, '&gt;'), q)}</pre>`;
        }).join('');
        help.hidden = false;
        rule.hidden = false;
        const anchor = at >= 0 ? found[at][1] : log.length - 1;
        const end = Math.min(log.length, anchor + 2);
        const shown = 6 + Math.max(0, 5 - Math.min(found.length, 5));
        out.innerHTML = log.slice(Math.max(0, end - shown), end).join('\n');
        query.innerHTML = `<span>Search: ${q}<span class="cursor">_</span></span><span>${found.length ? `${at + 1}/${found.length}` : ''}</span>`;
        mode.innerHTML = '<span class="y">SEARCH</span>';
      };
      closed();
      await step(900);
      await press('Ctrl+F', 'search output');
      open('', 0);
      await step(500);
      for (let i = 1; i <= 5; i++) {
        open('knife'.slice(0, i), 0);
        await step(240);
      }
      await step(1000);
      await press('↑', 'older match');
      open('knife', 1);
      await step(900);
      await press('↑', 'older match');
      open('knife', 2);
      await step(500);
    },

    async highlight(rt, step) {
      const out = $(rt, '[data-out]');
      const input = $(rt, '[data-in]');
      const raw = [
        'You hack at the frost troll.',
        'A mouse drops a piece of lint on the floor.',
        'The frost troll smashes you with its club!',
        'A gentle breeze blows through the cave.',
        'You parry the frost troll\'s attack.',
        'The barkeep polishes a glass.',
        'You hack at the frost troll.',
        'A gentle breeze blows through the cave.',
        'The frost troll smashes you with its club!',
        'A mouse drops a piece of lint on the floor.',
      ];
      const clean: [string, number][] = [
        ['&gt; /group combat on', 500],
        ['[Group] combat enabled', 600],
        ['You hack at the frost troll.', 420],
        ['<span class="r">The frost troll smashes you with its club!</span>', 800],
        ['You parry the frost troll\'s attack.', 420],
        ['<span class="g">You hack the frost troll to pieces!</span>', 420],
        ['<span class="y">The frost troll drops a jagged tooth.</span>', 200],
      ];
      const lines: string[] = [];
      const show = () => { out.innerHTML = lines.slice(-12).join('\n'); };
      input.innerHTML = prompt('');
      show();
      await step(400);
      for (const l of raw) {
        lines.push(l);
        show();
        await step(240);
      }
      mark('gag');
      await step(500);
      await type(step, input, '/group combat on', 55);
      await step(300);
      input.innerHTML = prompt('');
      lines.length = 0;
      for (const [l, ms] of clean) {
        if (l.includes('smashes')) mark('color');
        lines.push(l);
        show();
        await step(ms);
      }
      mark('');
    },

    async input(rt, step, press) {
      const plain = $(rt, '[data-plain]');
      const comp = $(rt, '[data-comp]');
      const inp = $(rt, '[data-in]');
      const bar = $(rt, '[data-bar]');
      const num = $(rt, '[data-num]');
      const count = $(rt, '[data-count]');
      const names = ['Morwen', 'Mordak', 'Moreldir'];
      const complete = (sel: number) => {
        inp.innerHTML = prompt(`tell ${names[sel]} `);
        bar.innerHTML = `<span>${names.map((x, i) => `<span class="${i === sel ? 'tsel' : 'd'}">${x}</span>`).join(' ')}</span><span class="d">(${sel + 1}/3)</span>`;
      };
      const draw = (lines: string[]) => {
        num.innerHTML = lines.map((l, i) => `<span>${i + 1} │ </span>${l}${i === lines.length - 1 ? '<span class="cursor">_</span>' : ''}`).join('\n');
        count.textContent = String(lines.length);
      };
      const room = $(rt, '.out.grow');
      const mail = room.innerHTML;
      room.innerHTML = ['<span class="g">&gt; w</span>', '<b>Market Square</b>', 'Stalls crowd the square under striped awnings.', '<span class="y">A town guard</span> watches the crowd.', '<span class="g">&gt; s</span>', mail].join('\n');
      plain.hidden = false;
      comp.hidden = true;
      bar.innerHTML = STATUS;
      inp.innerHTML = prompt('');
      await step(600);
      await type(step, inp, 'tell Mo', 90);
      await press('Tab', 'complete a name');
      complete(0);
      await step(800);
      await press('Tab', 'next name');
      complete(1);
      await step(800);
      await press('Tab', 'next name');
      complete(2);
      await step(1300);
      inp.innerHTML = prompt('');
      bar.innerHTML = STATUS;
      await step(400);
      await press('Ctrl+Enter', 'numbered editor');
      room.innerHTML = mail;
      plain.hidden = true;
      comp.hidden = false;
      const text = ['Dear Kralk,', '', 'The knife you forged is perfect.', '  - Tundra'];
      const lines = [''];
      draw(lines);
      await step(400);
      for (let l = 0; l < text.length; l++) {
        lines[l] = '';
        for (const ch of text[l]) {
          lines[l] += ch;
          draw(lines);
          await step(34);
        }
        if (l < text.length - 1) {
          lines.push('');
          draw(lines);
          await step(240);
        }
      }
    },

    async trigger(rt, step) {
      const out = $(rt, '[data-out]');
      const input = $(rt, '[data-in]');
      const height = getComputedStyle($(rt, '.inl')).display === 'none' ? 12 : 5;
      const before = [
        '<span class="g">&gt; d</span>',
        '<b>Ice Tunnel</b>',
        'Blue light filters down through the walls.',
        '<span class="d">    There are two obvious exits: </span><span class="g">up and north</span>',
        PROMPTLINE,
        '<span class="g">&gt; n</span>',
        'You duck under a shelf of ice.',
      ];
      const lines = [
        ...before,
        '<b>Troll Cave</b>',
        'Icicles hang from the low ceiling. Bones crunch underfoot.',
        '<span class="d">    There is one obvious exit: </span><span class="g">south</span>',
        '<span class="y">A frost troll</span> is here, gnawing a femur.',
        PROMPTLINE,
        '<span class="g">&gt; kill troll</span>',
        'You hack at the frost troll.',
        '<span class="r">The frost troll smashes you with its club!</span>',
        'Your health is 24%.',
        'You get a healing potion from your bag.',
        'You quaff a healing potion. You feel much better.',
        'You drop an empty bottle.',
        '<span class="d">[</span><span class="g">HP:301</span> <span class="c">EP:97</span><span class="d">]</span>',
      ];
      const show = (c: number) => {
        const end = c + before.length;
        const visible = lines.slice(Math.max(0, end - height), end);
        out.innerHTML = [...Array(height - visible.length).fill(''), ...visible].join('\n');
      };
      show(5);
      input.innerHTML = prompt('');
      await step(700);
      await type(step, input, 'kill troll', 70);
      await step(300);
      input.innerHTML = prompt('');
      for (const [c, ms] of [[6, 500], [7, 800], [8, 700]]) {
        show(c);
        await step(ms);
      }
      show(9);
      mark('match');
      await step(800);
      mark('if');
      await step(700);
      mark('send');
      await step(500);
      mark('alias');
      await step(500);
      for (const [c, ms] of [[10, 650], [11, 800], [12, 650], [13, 500]]) {
        show(c);
        await step(ms);
      }
      mark('');
    },
  };

  function fillDesc(card: HTMLElement) {
    desc.textContent = '';
    const h = document.createElement('h2');
    h.textContent = card.dataset.name!;
    const p = document.createElement('p');
    p.textContent = card.dataset.text!;
    const snip = document.createElement('div');
    snip.className = 'snip';
    snip.id = 'snip';
    const more = document.createElement('p');
    more.className = 'more';
    const a = document.createElement('a');
    a.href = card.dataset.link!;
    a.textContent = card.dataset.label!;
    more.append(a);
    desc.append(h, p, snip, more);
    desc.classList.remove('swap');
    void desc.offsetWidth;
    desc.classList.add('swap');
  }

  // Templates with a data-stage belong to one step of a demo; the finished
  // frame uses "adv".
  const template = (card: HTMLElement, kind: string, stage?: string) =>
    (card.querySelector(`template.${kind}[data-stage="${stage || 'adv'}"]`) ||
      card.querySelector(`template.${kind}:not([data-stage])`)) as HTMLTemplateElement | null;

  function fillCode(card: HTMLElement, stage?: string) {
    const side = (template(card, 'code', stage) || template(card, 'keys', stage))!;
    sidehead.textContent = side.dataset.title!;
    sidebody.replaceChildren(side.content.cloneNode(true));
    sidebody.classList.remove('swap');
    void sidebody.offsetWidth;
    sidebody.classList.add('swap');
    const line = template(card, 'oneline', stage);
    byId('snip').replaceChildren(...(line ? [line.content.cloneNode(true)] : []));
  }

  function layout() {
    const at = cards.indexOf(active);
    const n = cards.length;
    cards.forEach((card, i) => {
      const p = (i - at + n) % n;
      card.style.setProperty('--p', String(Math.min(p, 3)));
      card.style.opacity = p > 3 ? '0' : '';
      card.style.zIndex = String(n - p);
      card.classList.toggle('front', p === 0);
    });
    fillDesc(active);
    fillCode(active);
    [...strip.children].forEach((b, i) => b.setAttribute('aria-pressed', String(cards[i] === active)));
  }

  async function play(card: HTMLElement, picked: boolean) {
    const id = ++run;
    const rt = $(card, '.rt');
    const step: Step = (ms) => new Promise((resolve, reject) => setTimeout(() => (run === id ? resolve() : reject()), ms));
    const press: Press = async (k, label) => {
      keycap.textContent = k;
      keylabel.textContent = label;
      key.classList.add('show');
      await step(850);
      keycap.classList.add('press');
      await step(130);
      keycap.classList.remove('press');
      setTimeout(() => {
        if (run === id) key.classList.remove('show');
      }, 260);
    };
    key.classList.remove('show');
    rt.innerHTML = finished.get(card)!;
    try {
      await anims[card.dataset.anim!](rt, step, press);
      await step(picked ? PICKED_HOLD : HOLD);
      while (hovering || document.hidden) await step(300);
    } catch {
      return; // superseded by a newer run
    }
    select(cards[(cards.indexOf(card) + 1) % cards.length], false);
  }

  function select(card: HTMLElement, picked: boolean) {
    if (card !== active) {
      const leaving = active;
      if (!reduced) {
        leaving.classList.add('out');
        setTimeout(() => leaving.classList.remove('out'), 340);
      }
      active = card;
      layout();
      setTimeout(() => {
        if (active !== leaving) $(leaving, '.rt').innerHTML = finished.get(leaving)!;
      }, 340);
    }
    if (!reduced) play(card, picked);
  }

  cards.forEach((card) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = card.dataset.name!;
    b.addEventListener('click', () => select(card, true));
    strip.append(b);
    card.addEventListener('click', () => select(card, true));
  });

  strip.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
    e.preventDefault();
    const n = cards.length;
    const to = (cards.indexOf(active) + (e.key === 'ArrowRight' ? 1 : n - 1)) % n;
    select(cards[to], true);
    (strip.children[to] as HTMLElement).focus();
  });

  wrap.addEventListener('mouseenter', () => { hovering = true; });
  wrap.addEventListener('mouseleave', () => { hovering = false; });

  layout();
  if (!reduced) play(active, false);
</script>
