---
// The landing page body. Each feature is shown in an HTML drawing of Rune's
// own UI (taken from tmux captures of the running client). A terminal's
// markup is its finished frame; the script at the bottom animates the ones
// marked data-anim while they are on screen.
// Terminal text sits in <pre> elements so HTML compression keeps its spacing.
const raw = import.meta.env.BASE_URL;
const base = raw.endsWith('/') ? raw : raw + '/';

const prompt342 = '<span class="d">[</span><span class="g">HP:342</span> <span class="c">EP:97</span><span class="d">]</span>';

// Output scrolls under the picker as it shrinks, so the picker terminal keeps
// more output than its finished frame shows.
const pickerOutput = [
  'Kralk says: the blade needs another hour on the anvil.',
  '<span class="g">&gt; n</span>',
  '<b>The Frozen Forge</b>',
  'Heat rolls off the coals in waves that die fast against the',
  'glacier walls. Kralk the smith hammers a knife blade at the',
  'anvil while Knubo scribbles quest-engine code on a slate.',
  '<span class="d">    There are two obvious exits: </span><span class="g">north and south</span>',
  prompt342,
];

const triggerOutput = [
  '<b>Troll Cave</b>',
  'Icicles hang from the low ceiling. Bones crunch underfoot.',
  '<span class="y">A frost troll</span> is here, gnawing a femur.',
  prompt342,
  '<span class="g">&gt; kill troll</span>',
  'You hack at the frost troll.',
  '<span class="r">The frost troll smashes you with its club!</span>',
  'Your health is 24%.',
  'You quaff a healing potion. You feel much better.',
  '<span class="d">[</span><span class="g">HP:301</span> <span class="c">EP:97</span><span class="d">]</span>',
];

const status = '<span><span class="g">●</span> <span class="d">mud.arctic.org:2700</span></span><span class="d">LIVE</span>';
---

<div class="landing not-content">
  <section class="hero">
    <div class="hero-copy">
      <h1>Rune MUD Client</h1>
      <div class="lede">
        <p>Modern, fast, and fully scriptable in Lua.</p>
        <p class="platforms">Linux, macOS, and Windows</p>
      </div>
      <div class="get">
        <div class="cmd">
          <span class="sh">$</span><span class="txt" id="install-cmd">go install github.com/mmcdole/rune/cmd/rune@latest</span>
          <button type="button" id="install-copy">Copy</button>
        </div>
        <span class="alt">or <a href="https://github.com/mmcdole/rune/releases">download a release</a></span>
      </div>
    </div>
    <figure>
      <div class="rt" data-anim="hero" role="img" aria-label="Rune connected to a MUD: a chat pane above the room output, and Tab completing a player name from the chat">
        <div class="phead"><span class="ttl">chat</span><i></i></div>
<pre class="out"><span class="y">[Chat]</span> Knubo: quest engine rewrite is nearly done, testing on the builder port tonight
<span class="y">[Chat]</span> Mirel: anyone selling torches? the crypt is pitch black past the second gate
<span class="c">[Tell]</span> Moreldir tells you: meet me at the icefall, bring rope
<span class="y">[Chat]</span> Mordak: forged knives at the frozen forge, cheap until the reboot</pre>
        <div class="hr tight"></div>
<pre class="out"><b>The Icefall Shore</b>
Black water gnaws at the shelf ice, and krill wash pink
against the shelf. Bridges sag toward the icefall in the
east, and something vast - the kraken, the old hands say -
shifts beneath the floe. Fresh tracks circle a seal hole.
<span class="d">    There are three obvious exits: </span><span class="g">north, east and west</span>
<span class="y">A polar bear paces here, sniffing the wind.</span>
<Fragment set:html={prompt342} /></pre>
        <div class="hr"></div>
        <pre class="out" data-in>&gt; tell Moreldir <span class="cursor">_</span></pre>
        <div class="hr"></div>
        <pre class="bar" data-bar><span><span class="tsel">Moreldir</span> <span class="d">Mordak</span></span><span class="d">(1/2)</span></pre>
      </div>
      <figcaption>A chat pane above the output. Tab completes names from recent output.</figcaption>
    </figure>
  </section>

  <section class="feature">
    <div class="copy">
      <h2>Pickers</h2>
      <p>Press <code>Ctrl+R</code> for history, <code>Ctrl+T</code> for aliases, or <code>/</code> for commands, then type to filter. Scripts can open a picker with their own items.</p>
    </div>
    <div class="rt" data-anim="picker" role="img" aria-label="The history picker filtering past commands that match tell">
      <pre class="out" data-out data-lines={JSON.stringify(pickerOutput)} set:html={pickerOutput.slice(-6).join('\n')} />
      <div class="hr"></div>
      <div class="pick" data-pick>
        <pre class="row on">&gt; <span class="mt">tell</span> soblak ready when you are</pre>
        <pre class="row">  <span class="mt">tell</span> moreldir on my way</pre>
        <pre class="row">  <span class="mt">tell</span> dios when is the restart?</pre>
        <pre class="row">  <span class="mt">tell</span> kralk is the knife done?</pre>
      </div>
      <div class="hr"></div>
      <pre class="out" data-q>History: tell<span class="cursor">_</span></pre>
      <div class="hr"></div>
      <pre class="bar" set:html={status} />
    </div>
    <p class="more"><a href={`${base}interface/pickers/`}>Pickers guide</a></p>
  </section>

  <section class="feature">
    <div class="copy">
      <h2>Multiline input</h2>
      <p>Paste several lines, or press <code>Ctrl+Enter</code>, and the input becomes a numbered editor. Enter sends each line as written. <code>Ctrl+E</code> opens the draft in your <code>$EDITOR</code>.</p>
    </div>
    <div class="rt" role="img" aria-label="The verbatim composer holding a four-line letter at a mudmail prompt">
<pre class="out"><b>The Post Office</b>
A clerk sorts letters behind a frost-rimed counter.
<span class="g">&gt; mail kralk</span>
Subject: the knife
Enter your message. End with a '.' on a line by itself.</pre>
      <div class="lbl"><span class="y">VERBATIM · 4 lines</span><i></i><span class="end">Alt+V command</span></div>
<pre class="num"><span>1 │ </span>Dear Kralk,
<span>2 │ </span>
<span>3 │ </span>The knife you forged is perfect.
<span>4 │ </span>  - Tundra<span class="cursor">_</span></pre>
      <div class="lbl"><span>Enter send · Ctrl+J newline · Esc×2 discard · Ctrl+E editor</span><i></i></div>
      <pre class="bar" set:html={status} />
    </div>
    <p class="more"><a href={`${base}interface/input/`}>Input and history</a></p>
  </section>

  <section class="feature">
    <div class="copy">
      <h2>Layouts</h2>
      <p>Split the screen into rows and columns of panes, from one sidebar to a full screen of monitors. Show or hide any pane with a key.</p>
    </div>
    <div class="pair">
      <div class="rt" data-anim="sidebar" role="img" aria-label="A sidebar layout: output and input on the left, chat and map panes stacked on the right">
        <div class="split">
          <div class="main">
<pre class="out"><b>Market Square</b>
Stalls crowd the square under striped
awnings, and a fountain splashes at
its centre. Traders call out prices
for furs and lamp oil.
<span class="d">    Exits: </span><span class="g">north, east, south, west</span>
<span class="y">A town guard</span> watches the crowd.
<Fragment set:html={prompt342} />
<span class="g">&gt; buy lamp oil</span>
The trader hands you a flask of oil.</pre>
            <div class="hr"></div>
            <pre class="out">&gt; <span class="cursor">_</span></pre>
          </div>
          <div class="side">
<pre class="hbox"><span class="ttl">chat</span><span class="y">[Chat]</span> Knubo: almost done
<span class="c">[Tell]</span> Kralk: knife ready
<span class="y">[Chat]</span> Mirel: wts torch</pre>
<pre class="hbox"><span class="ttl">map</span><span class="d">      [ ]---[ ]
       |
[ ]---</span>[<span class="y">*</span>]<span class="d">---[ ]
       |
      [ ]</span></pre>
          </div>
        </div>
        <div class="hr"></div>
        <pre class="bar" set:html={status} />
      </div>
      <figcaption>Sidebar</figcaption>
      <div class="rt" role="img" aria-label="A three-column layout: map and group on the left, output in the middle, tells and chat on the right, with health and energy gauges in the bottom bar">
        <div class="tri">
          <div class="col left">
<pre class="hbox"><span class="ttl">map</span><span class="d">   [ ]-[ ]
    |
[ ]-</span>[<span class="y">*</span>]<span class="d">-[ ]
    |
   [ ]</span></pre>
<pre class="hbox"><span class="ttl">group</span>Tundra    <span class="g">342</span>
Moreldir  <span class="y">198</span>
Ozric      <span class="r">41</span></pre>
          </div>
          <div class="main">
<pre class="out"><b>The Crypt Gate</b>
Cold air spills from the
stairs below. Bones litter
the threshold.
<span class="d">    Exits: </span><span class="g">down, south</span>
<span class="y">A skeletal guard</span> blocks
the stairs.
<span class="g">&gt; kill guard</span>
You smash the guard.
<span class="r">The guard cuts Ozric.</span>
Ozric is bleeding badly.</pre>
            <div class="hr"></div>
            <pre class="out">&gt; heal ozric<span class="cursor">_</span></pre>
          </div>
          <div class="col right">
<pre class="hbox"><span class="ttl">tells</span>Kralk: knife is ready
Ozric: heal me pls!!</pre>
<pre class="hbox"><span class="ttl">chat</span><span class="y">[Chat]</span> Knubo: soon
<span class="y">[Chat]</span> Mirel: torch?</pre>
          </div>
        </div>
        <div class="hr"></div>
        <pre class="bar"><span><span class="d">HP</span> <span class="gauge"><i class="hp"></i></span> 342/400  <span class="d">EP</span> <span class="gauge short"><i class="ep"></i></span> 97/120</span><span class="d">The Crypt Gate</span></pre>
      </div>
      <figcaption>Three columns</figcaption>
    </div>
    <p class="more"><a href={`${base}interface/layout/`}>Layout guide</a></p>
  </section>

  <section class="feature">
    <div class="copy">
      <h2>Scripting</h2>
      <p>Triggers, aliases, timers, hooks, key bindings, and slash commands are Lua. Rune loads <code>init.lua</code> at startup and <code>/reload</code> picks up changes.</p>
    </div>
    <div class="pair">
      <div class="file">
        <div class="fname">init.lua</div>
<pre class="code"><span class="cm">-- Drink a potion when health drops below 30%</span>
<span class="f">rune</span>.trigger.<span class="f">regex</span>(<span class="s">"^Your health is (\\d+)%\\.$"</span>, <span class="k">function</span>(m)
  <span class="k">if</span> <span class="f">tonumber</span>(m[<span class="n">1</span>]) &lt; <span class="n">30</span> <span class="k">then</span>
    <span class="f">rune</span>.<span class="f">send</span>(<span class="s">"quaff heal"</span>)
  <span class="k">end</span>
<span class="k">end</span>)</pre>
      </div>
      <div class="rt" data-anim="trigger" role="img" aria-label="The trigger firing: a low health line followed by the potion being drunk">
        <pre class="out" data-out data-lines={JSON.stringify(triggerOutput)} set:html={triggerOutput.slice(-6).join('\n')} />
        <div class="hr"></div>
        <pre class="out" data-in>&gt; <span class="cursor">_</span></pre>
        <div class="hr"></div>
        <pre class="bar" set:html={status} />
      </div>
    </div>
    <p class="more"><a href={`${base}getting-started/scripting-basics/`}>Scripting basics</a></p>
  </section>

  <section class="closing">
    <h2>Get started</h2>
    <p>Connect from your shell, then save the world so you can reconnect by name.</p>
    <div class="cmd"><span class="sh">$</span><span class="txt">rune mud.arctic.org 2700</span></div>
    <div class="cmd"><span class="sh">&gt;</span><span class="txt">/world add arctic mud.arctic.org 2700</span></div>
    <p class="more">
      <a href={`${base}getting-started/first-session/`}>Your first session</a> · <a href={`${base}getting-started/migrating/`}>Coming from Mudlet, TinTin++, or MUSHclient</a>
    </p>
  </section>
</div>

<style is:global>
  /* Global because the terminal script writes markup that scoped styles
     would not reach. Everything is nested under .landing. */
  .landing {
    --ground: #101211;
    --surface: #161918;
    --rule: #262b29;
    --fg: #e1e4de;
    --text: #c9cdc6;
    --muted: #8e958f;
    --faint: #5d645f;
    --brass: #c8a25a;
    /* ANSI colors, used only inside terminals */
    --t-cyan: #7fc4cf;
    --t-green: #9fbf7a;
    --t-yellow: #d6b866;
    --t-red: #d98a86;
    --t-mag: #b59ad0;
    --t-blue: #8eaad8;
    --t-badge: #5b5fc4;
    --t-pink: #e889c8;
    --t-line: #3a403d;
    --mono: var(--sl-font-mono);

    color: var(--fg);
    font-size: 16px;
    line-height: 1.6;

    & > section {
      max-width: 820px;
      margin: 0 auto;
    }
    & a {
      color: var(--fg);
      text-underline-offset: 3px;
      text-decoration-color: var(--faint);
    }
    & code {
      font: 0.875em var(--mono);
      color: var(--fg);
    }
    & pre {
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      color: inherit;
      overflow: visible;
    }
    & figure {
      margin: 0;
      display: grid;
      gap: 10px;
      min-width: 0;
    }
    & figcaption {
      font-size: 13px;
      color: var(--faint);
    }

    /* Hero */
    & .hero {
      padding-block: 56px 64px;
      display: grid;
      gap: 48px;
    }
    & .hero-copy {
      display: grid;
      gap: 22px;
      min-width: 0;
    }
    & h1 {
      font-size: clamp(38px, 6vw, 64px);
      line-height: 1.04;
      font-weight: 600;
      letter-spacing: -0.03em;
      margin: 0;
      color: var(--fg);
      text-wrap: balance;
    }
    & .lede {
      display: grid;
      gap: 4px;
      & p { margin: 0; font-size: 20px; color: var(--muted); }
      & .platforms { font-size: 14px; color: var(--faint); }
    }
    & .get {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px 20px;
      margin-top: 6px;
      min-width: 0;
    }
    & .get .alt {
      font-size: 14px;
      color: var(--muted);
    }
    & .cmd {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
      max-width: 100%;
      font: 13.5px var(--mono);
      background: var(--surface);
      border: 1px solid var(--rule);
      border-radius: 4px;
      padding: 9px 10px 9px 14px;
      & .sh { color: var(--faint); user-select: none; }
      & .txt { overflow-x: auto; white-space: nowrap; }
      & button {
        font: 12px var(--sl-font);
        color: var(--muted);
        background: none;
        border: 1px solid var(--rule);
        border-radius: 3px;
        padding: 2px 8px;
        cursor: pointer;
      }
      & button:hover { color: var(--fg); }
    }

    /* Feature sections: heading, paragraph, terminal, one link */
    & .feature {
      border-top: 1px solid var(--rule);
      padding-block: 56px;
      display: grid;
      gap: 22px;
    }
    & .copy {
      display: grid;
      gap: 10px;
      max-width: 62ch;
      & p { margin: 0; color: var(--text); }
    }
    & h2 {
      font-size: 24px;
      font-weight: 600;
      letter-spacing: -0.015em;
      margin: 0;
      color: var(--fg);
    }
    & .more {
      margin: -4px 0 0;
      font-size: 14px;
    }
    & .pair {
      display: grid;
      gap: 14px;
      & figcaption { margin: -6px 0 6px; }
    }
    & .file {
      display: grid;
      min-width: 0;
    }
    & .fname {
      font: 12px var(--mono);
      color: var(--muted);
      background: var(--surface);
      border: 1px solid var(--rule);
      border-bottom: 0;
      border-radius: 4px 4px 0 0;
      padding: 5px 16px;
      justify-self: start;
    }
    & pre.code {
      background: var(--surface);
      border: 1px solid var(--rule);
      border-radius: 0 4px 4px 4px;
      padding: 14px 16px;
      font: 13.5px/1.6 var(--mono);
      color: var(--text);
      overflow-x: auto;
      & .k { color: var(--t-mag); }
      & .s { color: var(--t-green); }
      & .n { color: var(--t-yellow); }
      & .cm { color: var(--faint); }
      & .f { color: var(--t-cyan); }
    }
    & .closing {
      border-top: 1px solid var(--rule);
      padding-block: 56px 72px;
      display: grid;
      gap: 16px;
      justify-items: start;
      & p { margin: 0; color: var(--muted); }
      & .cmd { width: 100%; max-width: 34rem; }
    }

    /* Terminals: Rune's own UI */
    & .rt {
      position: relative;
      background: var(--surface);
      border: 1px solid var(--rule);
      border-radius: 4px;
      padding: 14px 16px 8px;
      font: 14px/1.4 var(--mono);
      color: var(--text);
      overflow: hidden;
      min-width: 0;
      & > * { min-width: 62ch; }
      & .out, & .num, & .bar, & .hbox { white-space: pre; }
      & .out { overflow: hidden; }
      & b { font-weight: 600; color: #eef0ea; }
    }
    & .rt[data-anim] { cursor: pointer; }
    & .hr {
      border-top: 1px solid var(--t-line);
      margin-block: 0.45em;
      &.tight { margin-block: 0.25em; }
    }
    & .bar { display: flex; justify-content: space-between; }
    & .tsel { background: #d4d7d0; color: var(--surface); }
    & .ttl { background: var(--t-badge); color: #f4f2dc; padding: 0 1ch; }
    & .phead {
      display: flex;
      align-items: center;
      & i { flex: 1; border-top: 1px solid var(--t-line); }
    }
    & .pick .row { color: #cfd2cb; }
    & .pick .row.on { background: var(--t-badge); color: #f4f2dc; }
    & .mt { color: var(--t-pink); font-weight: 600; }
    & .lbl {
      display: flex;
      align-items: center;
      gap: 1ch;
      white-space: pre;
      color: var(--faint);
      margin-block: 0.45em;
      &::before, &::after { content: ''; width: 1ch; border-top: 1px solid var(--t-line); }
      &::after { order: 9; }
      & i { flex: 1; border-top: 1px solid var(--t-line); }
      & .end { order: 8; }
    }
    & .num span { color: var(--faint); }
    & .hbox {
      position: relative;
      border-top: 1px solid var(--t-line);
      padding: 0.55em 0 0 1ch;
      & > .ttl { position: absolute; top: -0.72em; left: 0; line-height: 1.4; }
    }
    & .split, & .tri { display: grid; }
    & .split { grid-template-columns: minmax(0, 1fr) 27ch; }
    & .split.hid { grid-template-columns: minmax(0, 1fr) 0; }
    & .split.hid .side { display: none; }
    & .tri { grid-template-columns: 14ch minmax(0, 1fr) 22ch; }
    & .main {
      display: grid;
      align-content: end;
      min-width: 0;
      padding-right: 1ch;
      & .hr { margin-right: -1ch; }
    }
    & .tri .main {
      padding-left: 1ch;
      & .hr { margin-left: -1ch; }
    }
    & .side, & .col {
      display: grid;
      grid-template-rows: 1fr 1fr;
      padding-top: 0.7em;
      overflow: hidden;
    }
    & .side { border-left: 1px solid var(--t-line); gap: 0.9em; }
    & .col { gap: 1.4em; }
    & .col.left { border-right: 1px solid var(--t-line); }
    & .col.left .hbox { padding: 0.55em 1ch 0 0; }
    & .col.right { border-left: 1px solid var(--t-line); }
    & .gauge {
      display: inline-block;
      width: 14ch;
      height: 0.7em;
      background: var(--t-line);
      &.short { width: 8ch; }
      & i { display: block; height: 100%; }
      & .hp { width: 85%; background: var(--t-green); }
      & .ep { width: 81%; background: var(--t-blue); }
    }
    & .c { color: var(--t-cyan); }
    & .g { color: var(--t-green); }
    & .y { color: var(--t-yellow); }
    & .b { color: var(--t-blue); }
    & .r { color: var(--t-red); }
    & .d { color: var(--faint); }
    & .cursor {
      display: inline-block;
      width: 0.6em;
      background: #d4d7d0;
      color: transparent;
    }

    /* Key-press overlay: dims the terminal and shows a keycap with a label */
    & .kov {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      background: rgba(12, 14, 13, 0.62);
      opacity: 0;
      transition: opacity 0.2s ease-out;
      pointer-events: none;
      &.show { opacity: 1; }
      & > div {
        display: grid;
        justify-items: center;
        gap: 10px;
        background: var(--ground);
        border: 1px solid var(--rule);
        border-radius: 10px;
        padding: 16px 24px 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
      }
      & kbd {
        font: 600 22px var(--mono);
        color: #eef0ea;
        background: var(--surface);
        border: 1px solid var(--rule);
        border-bottom-width: 3px;
        border-radius: 8px;
        padding: 8px 20px;
      }
      & span { font: 13px var(--mono); color: var(--brass); }
    }

    /* Narrow screens: every terminal shrinks at the same rate so 66 columns
       (40em of Plex Mono) always fit, and they share one font size. */
    & .hero, & .feature, & .pair { container-type: inline-size; }
    & .rt { font-size: clamp(6.5px, (100cqw - 34px) / 40, 14px); }
    @media (max-width: 760px) {
      & .hero { padding-block: 40px 48px; gap: 32px; }
    }
    @media (max-width: 560px) {
      & .cmd .txt { white-space: normal; overflow-wrap: anywhere; }
    }
    @media (prefers-reduced-motion: no-preference) {
      & .cursor { animation: blink 1.1s steps(1) infinite; }
    }
  }
  @keyframes blink {
    50% { opacity: 0; }
  }

  /* The landing provides its own hero: hide the auto-rendered page title. */
  .content-panel:has(> .sl-container > h1#_top) { display: none; }
  h1#_top { display: none; }
</style>

<script>
  const copy = document.getElementById('install-copy');
  const cmd = document.getElementById('install-cmd');
  copy?.addEventListener('click', () => {
    navigator.clipboard.writeText(cmd?.textContent ?? '').then(
      () => {
        copy.textContent = 'Copied';
        setTimeout(() => (copy.textContent = 'Copy'), 1500);
      },
      () => {},
    );
  });

  // Terminal animations. Each terminal's markup is its finished frame. While a
  // terminal is on screen it resets to its opening frame, plays, holds the
  // finished frame, and repeats; a click restarts it. Reduced-motion visitors
  // see only the finished frames.
  type Step = (ms: number) => Promise<void>;
  type Anim = (term: HTMLElement, step: Step) => Promise<void>;

  const STATUS = '<span><span class="g">●</span> <span class="d">mud.arctic.org:2700</span></span><span class="d">LIVE</span>';
  const HOLD = 3500;
  const prompt = (text: string) => `&gt; ${text}<span class="cursor">_</span>`;
  const $ = (term: HTMLElement, sel: string) => term.querySelector(sel) as HTMLElement;

  // Shows a keycap overlay, waits, and returns a function that hides it.
  async function keycap(term: HTMLElement, step: Step, key: string, label: string) {
    let overlay = term.querySelector('.kov');
    if (!overlay) {
      overlay = document.createElement('div');
      overlay.className = 'kov';
      overlay.innerHTML = '<div><kbd></kbd><span></span></div>';
      term.appendChild(overlay);
    }
    overlay.querySelector('kbd')!.textContent = key;
    overlay.querySelector('span')!.textContent = label;
    overlay.classList.add('show');
    await step(1100);
    return () => overlay!.classList.remove('show');
  }

  async function type(step: Step, el: HTMLElement, text: string, ms = 70) {
    for (let i = 1; i <= text.length; i++) {
      el.innerHTML = prompt(text.slice(0, i));
      await step(ms);
    }
  }

  const anims: Record<string, Anim> = {
    async hero(term, step) {
      const input = $(term, '[data-in]');
      const bar = $(term, '[data-bar]');
      const names = ['Moreldir', 'Mordak'];
      const candidates = (sel: number) =>
        `<span>${names.map((n, i) => `<span class="${i === sel ? 'tsel' : 'd'}">${n}</span>`).join(' ')}</span>` +
        `<span class="d">(${sel + 1}/${names.length})</span>`;
      bar.innerHTML = STATUS;
      input.innerHTML = prompt('');
      await step(600);
      await type(step, input, 'tell Mo', 90);
      const complete = (sel: number) => {
        input.innerHTML = prompt(`tell ${names[sel]} `);
        bar.innerHTML = candidates(sel);
      };
      const hide = await keycap(term, step, 'Tab', 'complete a name from recent output');
      complete(0);
      await step(400);
      hide();
      await step(900);
      complete(1);
      await step(900);
      complete(0);
    },

    // The picker sits on the input line; as matches drop out, the list
    // shrinks and more output shows above it.
    async picker(term, step) {
      const out = $(term, '[data-out]');
      const rows = $(term, '[data-pick]');
      const query = $(term, '[data-q]');
      const output: string[] = JSON.parse(out.dataset.lines!);
      const height = 10;
      const history = [
        'tell soblak ready when you are',
        'tell moreldir on my way',
        'kill polar bear',
        'tell dios when is the restart?',
        'get all from corpse',
        'tell kralk is the knife done?',
      ];
      const render = (q: string) => {
        const hits = history.filter((h) => h.includes(q));
        rows.innerHTML = hits
          .map((h, i) => {
            const at = q ? h.indexOf(q) : -1;
            const text = at < 0 ? h : `${h.slice(0, at)}<span class="mt">${q}</span>${h.slice(at + q.length)}`;
            return i === 0 ? `<pre class="row on">&gt; ${text}</pre>` : `<pre class="row">  ${text}</pre>`;
          })
          .join('');
        out.innerHTML = output.slice(-(height - hits.length)).join('\n');
        query.innerHTML = `History: ${q}<span class="cursor">_</span>`;
      };
      const hide = await keycap(term, step, 'Ctrl+R', 'search command history');
      render('');
      hide();
      await step(1000);
      for (let i = 1; i <= 4; i++) {
        render('tell'.slice(0, i));
        await step(320);
      }
    },

    async sidebar(term, step) {
      const split = $(term, '.split');
      split.classList.remove('hid');
      await step(900);
      let hide = await keycap(term, step, 'F3', 'hide the sidebar');
      split.classList.add('hid');
      hide();
      await step(2200);
      hide = await keycap(term, step, 'F3', 'show it again');
      split.classList.remove('hid');
      hide();
    },

    // Output scrolls like a terminal: a fixed window over the last lines.
    async trigger(term, step) {
      const out = $(term, '[data-out]');
      const input = $(term, '[data-in]');
      const lines: string[] = JSON.parse(out.dataset.lines!);
      const height = 6;
      const show = (n: number) => {
        const visible = lines.slice(Math.max(0, n - height), n);
        out.innerHTML = [...Array(height - visible.length).fill(''), ...visible].join('\n');
      };
      show(4);
      input.innerHTML = prompt('');
      await step(700);
      await type(step, input, 'kill troll');
      await step(300);
      input.innerHTML = prompt('');
      for (const [n, ms] of [[5, 500], [6, 800], [7, 600], [8, 700], [9, 300], [10, 0]]) {
        show(n);
        await step(ms);
      }
    },
  };

  interface State {
    run: number;
    running: boolean;
    visible: boolean;
  }
  const states = new WeakMap<HTMLElement, State>();

  async function play(term: HTMLElement) {
    const state = states.get(term)!;
    const run = ++state.run;
    state.running = true;
    const step: Step = (ms) =>
      new Promise((resolve, reject) => setTimeout(() => (state.run === run ? resolve() : reject()), ms));
    term.querySelector('.kov')?.classList.remove('show');
    try {
      do {
        await anims[term.dataset.anim!](term, step);
        await step(HOLD);
      } while (state.visible);
    } catch {
      return; // superseded by a newer run
    }
    state.running = false;
  }

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const term = e.target as HTMLElement;
          const state = states.get(term)!;
          state.visible = e.isIntersecting;
          if (state.visible && !state.running) play(term);
        }
      },
      { threshold: 0.6 },
    );
    document.querySelectorAll<HTMLElement>('.rt[data-anim]').forEach((term) => {
      states.set(term, { run: 0, running: false, visible: false });
      term.title = 'Click to replay';
      term.addEventListener('click', () => play(term));
      observer.observe(term);
    });
  }
</script>
